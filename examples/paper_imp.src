(program
  (hill 94nop)
  (name paper and imp ring)
  (strategy a self-copying paper beside a three-point imp ring)
  (const istep 2667)
  (let (n 7)
    (let (d 2000)
      (seq
        (SPL launch)
        (repeat
          (seq
            (MOV 7 (store n))
            (do-while (JN n) (MOV I (Dec n) (Dec d)))
            (SPL (Ind d))
            (ADD 2365 d)))
        (DAT 0 (store d))
        (label launch)
        (SPL (Dir 2))
        (SPL (Dir 1))
        (JMP (Dec vec))
        (JMP (+ imp (* 2 istep)))
        (JMP (+ imp istep))
        (JMP imp)
        (label vec)
        (DAT 0 0)
        (label imp)
        (MOV I (# 0) (Dir istep))))))

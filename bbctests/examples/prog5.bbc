NAME: test sum indirection
DESCRIPTION: evaluates a function declaration
SRC:
(let (x 2)
  (let (rx x)
    (let (y 3)
      (let (ry y)
        (seq
          (JMP start)
          (SUB (store y) 0)
          (SUB 0 (store x))
          (SUB (store rx) (store ry))
          (label start)
          (ADD 4 (Ind rx))
          (ADD 5 (Ind ry)) )))))
EXPECTED:
;redcode-94b

  JMP    $start , #0     
_LET3 
  SUB.AB #3     , #0     
_LET1 
  SUB.AB #0     , #2     
_LET2 
_LET4 
  SUB.BA $_LET1 , $_LET3 
start 
  ADD.AB #4     , *_LET2 
  ADD.A  #5     , @_LET4 
  DAT    #0     , #0
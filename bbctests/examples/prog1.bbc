NAME: test dwarf
DESCRIPTION: evaluates a function declaration
SRC:
(let (x dest)
  (seq
    (MOV I (Dir -1) (store x))
    (ADD 4 x)
    (JMP x)
    (label dest) ))
EXPECTED:
;redcode-94b

_LET1 
  MOV.I  $-1    , $dest  
  ADD.AB #4     , $_LET1 
  JMP    $_LET1 , #0     
dest  
  DAT    $0     , $0
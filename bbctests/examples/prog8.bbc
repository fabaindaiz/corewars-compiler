NAME: test while comparation
DESCRIPTION: evaluates a function declaration
SRC:
(let (x 100)
  (let (y 10)
    (seq
      (JMP (Dir 2))
      (DAT (store x) (store y))
      (while (LT y x)
        (seq
          (MOV I (Dir x) (Dec x)) )))))
EXPECTED:
;redcode-94b

  JMP    $2     , #0     
_LET1 
_LET2 
  DAT    #100   , #10    
_WHI9 
  SLT.BA $_LET2 , $_LET1 
  JMP    $_WHF9 , #0     
  MOV.I  $_LET1 , {_LET1 
  JMP    $_WHI9 , #0     
_WHF9 
  DAT    $0     , $0
NAME: long labels
DESCRIPTION: evaluates a function declaration
SRC:
(let (x dest_with_some_extra_characters)
  (seq
      (MOV I (Dir -1) (store x))
      (ADD 4 x)
      (JMP x)
      (label dest_with_some_extra_characters) ))
EXPECTED:
;redcode-94b

_LET1 
  MOV.I  $-1    , $dest_with_some_extra_characters
  ADD.AB #4     , $_LET1 
  JMP    $_LET1 , #0     
dest_with_some_extra_characters
  DAT    #0     , #0
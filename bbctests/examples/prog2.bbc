NAME: test modifiers
DESCRIPTION: evaluates a function declaration
SRC:
(let (x 1)
  (let (y 2)
    (let (a 0)
      (let (b 0)
        (seq
          (JMP (Dir 2))
          (DAT (store x) (store y))
          (ADD x y)
          (ADD y y)
          (ADD y x)
          (MOV x a)
          (MOV a b)
          (DAT (store a) 0)
          (DAT 0 (store b)) )))))
EXPECTED:
;redcode-94b

  JMP    $2     , #0     
_LET1 
_LET2 
  DAT    #1     , #2     
  ADD.AB $_LET1 , $_LET2 
  ADD.B  $_LET2 , $_LET2 
  ADD.BA $_LET2 , $_LET1 
  MOV.A  $_LET1 , $_LET3 
  MOV.AB $_LET3 , $_LET4 
_LET3 
  DAT    #0     , #0     
_LET4 
  DAT    #0     , #0     
  DAT    $0     , $0
NAME: the quickscan finding something
DESCRIPTION: the quickscan archetype with probes 10 cells apart, so the first compares a cell of its own code with an empty one and attacks it; see behtests/quickscan_hit.beh
SRC:
(program
  (hill 94nop)
  (name quickscan)
  (strategy compare cell pairs across the core, bomb a difference, then clear)
  (const step 10)
  (const gap 100)
  (define (probe (k Num))
    (if (NE I (Dir (+ first (* k step))) (Dir (+ first (+ (* k step) gap))))
      (JMP (+ hits (* 2 (- k 1))))))
  (define (hit (k Num))
    (seq (MOV (# (- (+ first (* k step)) ptr)) ptr) (JMP found)))
  (seq
    (label first)
    (for k 1 16 (probe k))
    (JMP clear)
    (label hits)
    (for k 1 16 (hit k))
    (label found)
    (MOV I bomb (Ind ptr))
    (ADD gap ptr)
    (MOV I bomb (Ind ptr))
    (label clear)
    (repeat (MOV I bomb (Inc ptr)))
    (label ptr)
    (DAT 0 300)
    (label bomb)
    (DAT 0 0)))
EXPECTED:
;redcode-94nop
;name quickscan
;strategy compare cell pairs across the core, bomb a difference, then clear
;assert CORESIZE==8000 && MAXLENGTH==100
step EQU 10
gap EQU 100

first 
  SNE.I  $first+(1*step), $first+((1*step)+gap)
  JMP    $_IF7  , #0     
  JMP    $hits+(2*(1-1)), #0     
_IF7  
  SNE.I  $first+(2*step), $first+((2*step)+gap)
  JMP    $_IF10 , #0     
  JMP    $hits+(2*(2-1)), #0     
_IF10 
  SNE.I  $first+(3*step), $first+((3*step)+gap)
  JMP    $_IF13 , #0     
  JMP    $hits+(2*(3-1)), #0     
_IF13 

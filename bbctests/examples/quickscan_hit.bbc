_IF28 
  SNE.I  $first+(9*step), $first+((9*step)+gap)
  JMP    $_IF31 , #0     
  JMP    $hits+(2*(9-1)), #0     
_IF31 
  SNE.I  $first+(10*step), $first+((10*step)+gap)
  JMP    $_IF34 , #0     
  JMP    $hits+(2*(10-1)), #0     
_IF34 
  SNE.I  $first+(11*step), $first+((11*step)+gap)
  JMP    $_IF37 , #0     
  JMP    $hits+(2*(11-1)), #0     
_IF37 
  SNE.I  $first+(12*step), $first+((12*step)+gap)
  JMP    $_IF40 , #0     
  JMP    $hits+(2*(12-1)), #0     
_IF40 
  SNE.I  $first+(13*step), $first+((13*step)+gap)
  JMP    $_IF43 , #0     
  JMP    $hits+(2*(13-1)), #0     
_IF43 
  SNE.I  $first+(14*step), $first+((14*step)+gap)
  JMP    $_IF46 , #0     
  JMP    $hits+(2*(14-1)), #0     
_IF46 
  SNE.I  $first+(15*step), $first+((15*step)+gap)
  JMP    $_IF49 , #0     
  JMP    $hits+(2*(15-1)), #0     
_IF49 
  SNE.I  $first+(16*step), $first+((16*step)+gap)
  JMP    $_IF52 , #0     
  JMP    $hits+(2*(16-1)), #0     
_IF52 
  JMP    $clear , #0     
hits  
  MOV.AB #(first+(1*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(2*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(3*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(4*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(5*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(6*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(7*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(8*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(9*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(10*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(11*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(12*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(13*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(14*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(15*step))-ptr, $ptr   
  JMP    $found , #0     
  MOV.AB #(first+(16*step))-ptr, $ptr   
  JMP    $found , #0     
found 
  MOV.I  $bomb  , @ptr   
  ADD.AB #gap   , $ptr   
  MOV.I  $bomb  , @ptr   
clear 
_REP167
  MOV.I  $bomb  , >ptr   
  JMP    $_REP167, #0     
ptr   
  DAT    #0     , #300   
bomb  
  DAT    #0     , #0     
  DAT    $0     , $0     
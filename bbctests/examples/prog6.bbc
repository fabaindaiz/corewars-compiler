NAME: test repeat
DESCRIPTION: evaluates a function declaration
SRC:
(let (x (Dir 3))
    (repeat
      (seq
        (MOV I (Dir -1) (store x))
        (ADD 1 x) )))
EXPECTED:
;redcode-94b

_REP2 
_LET1 
  MOV.I  $-1    , $3     
  ADD.AB #1     , $_LET1 
  JMP    $_REP2 , #0     
  DAT    #0     , #0
NAME: snippet demo: the quickscan's probes and stubs snippets in the quickscan archetype
DESCRIPTION: includes snippets/quickscan.src and compiles to the quickscan archetype's code (labels renamed); see behtests/snippet_quickscan.beh
SRC:
(program
  (hill 94nop)
  (name quickscan)
  (strategy compare cell pairs across the core, bomb a difference, then clear)
  (const step 400)
  (const gap 100)
  (include "snippets/quickscan.src")
  (seq
    (label first)
    (probes first hits step gap)
    (JMP clear)
    (label hits)
    (stubs first ptr found step)
    (label found)
    (MOV I bomb (Ind ptr))
    (ADD gap ptr)
    (MOV I bomb (Ind ptr))
    (label clear)
    (repeat (MOV I bomb (Inc ptr)))
    (label ptr)
    (DAT 0 300)
    (label bomb)
    (DAT 0 0)))
EXPECTED:
;redcode-94nop
;name quickscan
;strategy compare cell pairs across the core, bomb a difference, then clear
;assert CORESIZE==8000 && MAXLENGTH==100
step EQU 400
gap EQU 100

first 
  SEQ.I  $first+(1*step), $first+((1*step)+gap)
  JMP    $hits+(2*(1-1)), #0     
_IF7  
  SEQ.I  $first+(2*step), $first+((2*step)+gap)
  JMP    $hits+(2*(2-1)), #0     

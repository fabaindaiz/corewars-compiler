NAME: a scanner in RED
DESCRIPTION: steps p by 10 and bombs a non-zero cell; phase-2 archetype suite (i-7d2612-34b61d), see behtests/archetype_scanner.beh
SRC:
(let (p 20)
  (seq
    (repeat
      (seq
        (ADD 10 p)
        (if (JN (Ind p))
          (MOV I bomb (Ind p)))))
    (DAT 0 (store p))
    (label bomb)
    (DAT 0 0)))
EXPECTED:
;redcode-94b

_REP4 
  ADD.AB #10    , $_LET1 
  JMZ.B  $_REP4 , @_LET1 
  MOV.I  $bomb  , @_LET1 
_IF9  
  JMP    $_REP4 , #0     
_LET1 
  DAT    #0     , #20    
bomb  
  DAT    #0     , #0     
  DAT    #0     , #0     
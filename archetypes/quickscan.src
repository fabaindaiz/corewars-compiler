(program
  (hill 94nop)
  (name quickscan)
  (strategy compare cell pairs across the core, bomb a difference, then clear)
  (const step 400)
  (const gap 100)
  (define (probe (k Num))
    (if (NE I (Dir (+ first (* k step))) (Dir (+ first (+ (* k step) gap))))
      (JMP (+ hits (* 2 (- k 1))))))
  (define (hit (k Num))
    (seq (MOV (# (- (+ first (* k step)) ptr)) ptr) (JMP found)))
  (seq
    (label first)
    (for k 1 16 (probe k))
    (JMP clear)
    (label hits)
    (for k 1 16 (hit k))
    (label found)
    (MOV I bomb (Ind ptr))
    (ADD gap ptr)
    (MOV I bomb (Ind ptr))
    (label clear)
    (repeat (MOV I bomb (Inc ptr)))
    (label ptr)
    (DAT 0 300)
    (label bomb)
    (DAT 0 0)))

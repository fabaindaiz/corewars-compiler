# a = 3, b = 9, n = -5, m = 5: the three DATs after JMP #0 hold a*3 = 9 and b = 9, 10-a = 7 and
# 0-a = -3, and 1-m = -4 (cdb shows them signed). Without parentheses around a constant's value, pMARS reads
# a*3 as 1+2*3 = 7.
golden: bbctests/examples/const_expressions.bbc
cell 1 1 DAT.F #9, #9
cell 1 2 DAT.F #7, #-3
cell 1 3 DAT.F #0, #-4
